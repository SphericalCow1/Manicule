{
  "compilerOptions": {
    "allowJs": false,
    "checkJs": false,
    "declaration": false,
    "isolatedModules": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": false,
    "outDir": ".tmp-tests",
    "rootDir": ".",
    "strict": true,
    "target": "ES2022"
  },
  "include": ["src/lib/**/*.ts", "tests/**/*.ts", "tests/**/*.d.ts"]
}
